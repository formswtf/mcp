  "description": "Model Context Protocol server for forms.wtf — build, manage, and analyze Web3 forms from any MCP client (Claude Desktop, Cursor, etc.).",
  "license": "MIT",
  "homepage": "https://github.com/formswtf/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formswtf/mcp.git"
  },
